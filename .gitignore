# ============================================================
# .gitignore — FARG Ar-Condicionado
# ============================================================

# ── Dependências (NUNCA sobe — gerado pelo npm install) ──
node_modules/
.npm

# ── Build de produção (gerado pelo npm run build) ──
dist/
dist-ssr/

# ── Variáveis de ambiente e segredos ──
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editores ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Testes ──
coverage/
*.lcov

# ── Cache ──
.vite/
.cache/
